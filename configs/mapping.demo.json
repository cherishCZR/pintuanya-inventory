{
  "demo": true,
  "source_confirmed": false,
  "version": "DEMO-1",
  "description": "DEMO 项目内部虚构结构，不是拼团呀接口",
  "success": {"path": ["ok"], "equals": true},
  "group_path": ["group"],
  "items_path": ["data", "items"],
  "fields": {"product_id": ["id"], "product_name": ["name"]},
  "sku_path": ["variants"],
  "sku_fields": {"sku_id": ["id"], "sku_name": ["name"]},
  "metrics": {
    "stock_remaining": {"path": ["remaining"], "confirmed": true, "evidence": "DEMO 人工定义为剩余可售数量"},
    "stock_total": {"path": ["capacity"], "confirmed": true, "evidence": "DEMO 人工定义总量"},
    "availability": {
      "path": ["buyable"], "confirmed": true, "evidence": "DEMO 人工定义状态",
      "values": [{"raw": true, "normalized": "in_stock"}, {"raw": false, "normalized": "out_of_stock"}]
    }
  }
}
